# ==============================================================================
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to `.env` for local configuration.
# - DO NOT store or commit real credentials, secrets, or keys into version control.
# ==============================================================================

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_placeholder
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_placeholder
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name-placeholder

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier_placeholder
SNOWFLAKE_USER=your_snowflake_username_placeholder
SNOWFLAKE_PASSWORD=your_snowflake_password_placeholder
SNOWFLAKE_ROLE=your_snowflake_role_placeholder
SNOWFLAKE_WAREHOUSE=your_snowflake_warehouse_placeholder
SNOWFLAKE_DATABASE=ZOMATO_DB
SNOWFLAKE_SCHEMA=RAW

# OpenAI / AI Layer Configuration
OPENAI_API_KEY=your_openai_api_key_placeholder

# Apache Airflow Configuration
AIRFLOW_UID=50000
